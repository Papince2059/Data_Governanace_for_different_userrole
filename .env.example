# ============================================================
# Enterprise Data Governance — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME="Enterprise Data Governance"
APP_VERSION=1.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:3001"]

# --- Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (governance_db) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=governance_user
POSTGRES_PASSWORD=governance_password
POSTGRES_DB=governance_db
DATABASE_URL=postgresql+asyncpg://governance_user:governance_password@localhost:5433/governance_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- OpenFGA Database (openfga_db) ---
OPENFGA_POSTGRES_DB=openfga_db

# --- OpenFGA ---
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=
OPENFGA_AUTH_MODEL_ID=
OPENFGA_TIMEOUT_SECONDS=10

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --- LLM ---
# Options: vertexai, ollama, mock
LLM_PROVIDER=vertexai
VERTEX_CREDENTIALS_PATH=vertex_credentials.json
VERTEX_PROJECT_ID=project-420160a8-73be-41cf-965
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# --- Document Storage ---
DOCUMENT_UPLOAD_DIR=./data/uploads
DOCUMENT_MAX_SIZE_MB=50

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.40
VECTOR_SEARCH_EF_SEARCH=100

# --- Rate Limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=60

# --- Docker Internal (used by docker-compose) ---
# These are only used in docker-compose.yml, not application code
POSTGRES_INTERNAL_USER=governance_user
POSTGRES_INTERNAL_PASSWORD=governance_password

