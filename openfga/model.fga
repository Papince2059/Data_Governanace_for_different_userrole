model
  schema 1.1

type user

type organization
  relations
    define member: [user]
    define admin: [user]

type department
  relations
    define member: [user, group#member]
    define parent: [organization]

type group
  relations
    define member: [user]
    define parent_department: [department]

type folder
  relations
    define owner: [user]
    define parent_department: [department]
    define viewer: [user, group#member, department#member] or owner
    define editor: [user, group#member] or owner
    define can_read: viewer or editor or owner
    define can_write: editor or owner

type document
  relations
    define owner: [user]
    define parent_folder: [folder]
    define parent_department: [department]
    define viewer: [user, group#member, department#member, folder#viewer] or owner
    define editor: [user, group#member, folder#editor] or owner
    define can_read: viewer or editor or owner
    define can_write: editor or owner
